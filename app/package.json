{
  "name": "lento-web",
  "description": "Lento practice web app",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "perf": "node perf/run.mjs",
    "e2e": "playwright test",
    "e2e:phone": "playwright test --project=phone",
    "e2e:watch": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "test:all": "npm test && npm run e2e && npm run build && npm run perf"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "happy-dom": "18.0.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "opensheetmusicdisplay": "1.9.9",
    "pdfjs-dist": "5.4.624"
  },
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later"
}
