{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/convert_pdfs.py",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "CLI: convert a folder",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/convert_pdfs.py",
            "args": ["${input:folder}", "--gpu", "force"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Tests: real homr on the GPU",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-m", "homr_gpu", "-s", "-W", "ignore"],
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [{ "id": "folder", "type": "promptString", "description": "Folder of PDFs to convert" }]
}
